const socket = new WebSocket(`ws://${window.location.hostname}:9877`);

let exchanges = new Map();
let selectedId = null;
let currentFilter = 'all';
let searchQuery = '';

const connectionStatus = document.getElementById('connectionStatus');
const exchangeCount = document.getElementById('exchangeCount');
const requestCount = document.getElementById('requestCount');
const requestList = document.getElementById('requestList');
const detailPane = document.getElementById('detailPane');
const searchInput = document.getElementById('searchInput');
const filterTags = document.getElementById('filterTags');
const filterBtns = document.querySelectorAll('.filter-btn');
const clearBtn = document.getElementById('clearBtn');
const exportBtn = document.getElementById('exportBtn');

socket.onopen = () => {
  connectionStatus.classList.add('connected');
  connectionStatus.querySelector('.label').textContent = 'Connected';
};

socket.onclose = () => {
  connectionStatus.classList.remove('connected');
  connectionStatus.querySelector('.label').textContent = 'Disconnected';
  setTimeout(() => location.reload(), 2000);
};

socket.onmessage = (event) => {
  const msg = JSON.parse(event.data);
  if (msg.type === 'exchange') {
    exchanges.set(msg.data.id, msg.data);
    renderRequestList();
    updateStats();
    if (selectedId === msg.data.id) {
      renderDetail(msg.data.id);
    }
  } else if (msg.type === 'summary') {
    updateStats();
  }
};

clearBtn.addEventListener('click', () => {
  exchanges.clear();
  selectedId = null;
  renderRequestList();
  updateStats();
  renderEmptyDetail();
});

exportBtn.addEventListener('click', () => {
  const data = Array.from(exchanges.values());
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `ai-proxy-export-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
});

searchInput.addEventListener('input', (e) => {
  searchQuery = e.target.value.toLowerCase();
  updateFilterTags();
  renderRequestList();
});

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.removeAttribute('active'));
    btn.setAttribute('active', '');
    currentFilter = btn.dataset.filter;
    renderRequestList();
  });
});

function updateFilterTags() {
  filterTags.innerHTML = '';
  if (!searchQuery) return;
  const tag = document.createElement('div');
  tag.className = 'tag';
  tag.innerHTML = `Search: "${escapeHtml(searchQuery)}" <button onclick="removeSearch()">✕</button>`;
  filterTags.appendChild(tag);
}

window.removeSearch = () => {
  searchInput.value = '';
  searchQuery = '';
  updateFilterTags();
  renderRequestList();
  searchInput.focus();
};

function escapeHtml(s) {
  return s.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function matches(exchange) {
  const req = exchange.request;
  // Filter by type
  if (currentFilter === 'error' && (!exchange.response || exchange.response.statusCode < 400)) return false;
  if (currentFilter === 'llm') {
    const host = req.host.toLowerCase();
    const url = req.url.toLowerCase();
    if (!host.includes('openai') && !host.includes('anthropic') && !host.includes('gemini') && !host.includes('google')) {
      if (!url.includes('/v1/') && !url.includes('/chat/') && !url.includes('/completions')) return false;
    }
  }
  if (currentFilter === 'slow' && exchange.response) {
    if (exchange.response.duration < 2000) return false;
  }
  // Search query
  if (searchQuery) {
    const searchStr = JSON.stringify({
      method: req.method,
      url: req.url,
      host: req.host,
      body: req.body || '',
      status: exchange.response?.statusCode || ''
    }).toLowerCase();
    if (!searchStr.includes(searchQuery)) return false;
  }
  return true;
}

function renderRequestList() {
  const filtered = Array.from(exchanges.values()).filter(matches);
  requestCount.textContent = `${filtered.length} request${filtered.length !== 1 ? 's' : ''}`;
  
  if (filtered.length === 0) {
    requestList.innerHTML = `
      <div class="empty-state">
        <p>⏳ No matching requests</p>
        <small>Try adjusting your filter or search</small>
      </div>`;
    return;
  }

  // Sort by timestamp descending
  filtered.sort((a, b) => b.request.timestamp - a.request.timestamp);
  
  requestList.innerHTML = filtered.map(ex => {
    const req = ex.request;
    const res = ex.response;
    const method = req.method || 'GET';
    const isError = res && res.statusCode >= 400;
    const cls = ['request-item', method, isError ? 'error' : ''].filter(Boolean).join(' ');
    const active = selectedId === ex.id ? 'active' : '';
    const time = new Date(req.timestamp).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const host = req.host || '';
    const path = req.path || req.url || '';
    const displayUrl = (host + path).slice(0, 40) || req.url || '';
    return `
      <div class="${cls} ${active}" data-id="${ex.id}" onclick="selectRequest('${ex.id}')">
        <div class="req-meta">
          <span class="req-method">${method}</span>
          <span class="req-time">${time}</span>
        </div>
        <div class="req-url">${escapeHtml(displayUrl)}</div>
        <div class="req-status">
          ${res ? `<span class="status-code ${res.statusCode < 400 ? 'ok' : 'err'}">${res.statusCode}</span>
          <span class="status-duration">${res.duration}ms</span>` : '<span style="color:var(--fg-muted)">pending…</span>'}
        </div>
      </div>`;
  }).join('');
}

function selectRequest(id) {
  selectedId = id;
  renderRequestList();
  renderDetail(id);
}

function renderDetail(id) {
  const ex = exchanges.get(id);
  if (!ex) return;
  renderRequestList();
  detailPane.innerHTML = buildDetailHtml(ex);
}

function renderEmptyDetail() {
  detailPane.innerHTML = `
    <div class="empty-detail">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <h3>Select a request to inspect</h3>
      <p>Click on any request from the list to see full details</p>
    </div>`;
}

function buildDetailHtml(ex) {
  const req = ex.request;
  const res = ex.response;
  const isLlmApi = req.url.toLowerCase().includes('/v1/') || req.host.toLowerCase().includes('openai') || req.host.toLowerCase().includes('anthropic') || req.host.toLowerCase().includes('gemini');
  
  let bodyHtml = '';
  if (req.body) {
    try {
      const obj = JSON.parse(req.body);
      bodyHtml = `<div class="json-view">${syntaxHighlight(obj)}</div>`;
    } catch {
      bodyHtml = `<div class="json-view">${escapeHtml(req.body)}</div>`;
    }
  } else {
    bodyHtml = `<div class="json-view" style="color:var(--fg-muted)">(no body)</div>`;
  }

  let respHtml = '';
  if (res) {
    let resBodyHtml = '';
    if (res.body) {
      try {
        const obj = JSON.parse(res.body);
        resBodyHtml = `<div class="json-view">${syntaxHighlight(obj)}</div>`;
      } catch {
        resBodyHtml = `<div class="json-view">${escapeHtml(res.body)}</div>`;
      }
    }

    const isOk = res.statusCode < 400;

    if (isLlmApi && res.body) {
      try {
        const obj = JSON.parse(res.body);
        const usage = obj.usage;
        const choices = obj.choices;
        let llmSection = '';
        if (usage) {
          const prompt = usage.prompt_tokens || 0;
          const completion = usage.completion_tokens || 0;
          const total = usage.total_tokens || 0;
          const estCost = (total / 1000) * 0.01; // rough estimate
          llmSection = `
            <div class="token-stats">
              <div class="token-stat prompt"><div class="stat-value">${prompt.toLocaleString()}</div><div class="stat-label">Prompt</div></div>
              <div class="token-stat completion"><div class="stat-value">${completion.toLocaleString()}</div><div class="stat-label">Completion</div></div>
              <div class="token-stat total"><div class="stat-value">${total.toLocaleString()}</div><div class="stat-label">Total Tokens</div></div>
            </div>
            <div class="cost-estimate">
              <div class="cost-value">$${estCost.toFixed(4)}</div>
              <div class="cost-label">Estimated cost @ $0.01/token</div>
            </div>`;
        }
        if (choices && choices.length) {
          const c = choices[0];
          if (c.message?.content) {
            llmSection += `<div class="detail-section"><h4>Response</h4><div class="response-card">${escapeHtml(c.message.content).replace(/\n/g, '<br>')}</div></div>`;
          }
          if (c.message?.tool_calls) {
            llmSection += `<div class="detail-section"><h4>Tool Calls</h4>`;
            c.message.tool_calls.forEach(tc => {
              llmSection += `<div class="tool-call-item"><div class="tool-call-header"><span class="tc-name">🔧 ${tc.function?.name || 'tool'}</span></div><div class="json-view">${syntaxHighlight(JSON.parse(tc.function?.arguments || '{}'))}</div></div>`;
            });
            llmSection += `</div>`;
          }
        }
        resBodyHtml = llmSection + (isOk ? `<div class="detail-section"><h4>Full Response</h4>${resBodyHtml}</div>` : resBodyHtml);
      } catch(e) {
        resBodyHtml = `<div class="json-view">${escapeHtml(res.body)}</div>`;
      }
    }

    respHtml = `
      <div class="detail-section">
        <h4>Response</h4>
        <div class="response-card">
          <div class="response-meta">
            <div class="response-meta-item status-${isOk?'ok':'err'}">🔔 ${res.statusCode} ${escapeHtml(res.statusMessage)}</div>
            <div class="response-meta-item">⏱ ${res.duration}ms</div>
            <div class="response-meta-item">📦 ${res.bodySize || 0} bytes</div>
          </div>
        </div>
      </div>
      ${resBodyHtml}`;
  } else {
    respHtml = `<div class="detail-section"><h4>Response</h4><div class="json-view" style="color:var(--fg-muted)">No response yet (pending)</div></div>`;
  }

  return `
    <div class="detail-card">
      <div class="detail-card-header">
        <div class="req-line">
          <span class="req-method-large" style="background:${getMethodColor(req.method)}">${req.method}</span>
          <span class="req-url-large">${escapeHtml(req.url)}</span>
        </div>
        <span class="req-timestamp">${new Date(req.timestamp).toLocaleString()}</span>
      </div>
    </div>
    <div class="detail-card-body">
      <div class="detail-section">
        <h4>Host</h4>
        <div class="json-view">${escapeHtml(req.host)}</div>
      </div>
      <div class="detail-section">
        <h4>Protocol</h4>
        <div class="json-view">${escapeHtml(req.protocol)}</div>
      </div>
      <div class="detail-section full-width">
        <h4>Request Headers</h4>
        ${syntaxHighlight(req.headers)}
      </div>
      <div class="detail-section full-width">
        <h4>Request Body</h4>
        ${bodyHtml}
      </div>
    </div>
    ${respHtml}`;
}

function getMethodColor(m) {
  switch((m||'').toUpperCase()) {
    case 'GET': return 'rgba(79,70,229,0.2)';
    case 'POST': return 'rgba(16,185,129,0.2)';
    case 'PUT': case 'PATCH': return 'rgba(245,158,11,0.2)';
    case 'DELETE': return 'rgba(239,68,68,0.2)';
    default: return 'rgba(34,211,238,0.2)';
  }
}

function syntaxHighlight(obj) {
  if (typeof obj === 'string') {
    try { obj = JSON.parse(obj); } catch {}
  }
  const json = typeof obj === 'object' ? JSON.stringify(obj, null, 2) : String(obj);
  return json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, (match) => {
    let cls = 'json-number';
    if (/^"/.test(match)) {
      cls = /:$/.test(match) ? 'json-key' : 'json-string';
    } else if (/true|false/.test(match)) {
      cls = 'json-boolean';
    } else if (/null/.test(match)) {
      cls = 'json-null';
    }
    return `<span class="${cls}">${match}</span>`;
  });
}

function updateStats() {
  const count = exchanges.size;
  exchangeCount.textContent = `${count} request${count !== 1 ? 's' : ''}`;
  requestCount.textContent = `${count} request${count !== 1 ? 's' : ''}`;
  if (count > 0) {
    const completed = Array.from(exchanges.values()).filter(e => e.response?.duration);
    if (completed.length > 0) {
      const avg = Math.round(completed.reduce((a, e) => a + e.response.duration, 0) / completed.length);
      document.getElementById('avgTime').textContent = `avg ${avg}ms`;
    }
  }
}
