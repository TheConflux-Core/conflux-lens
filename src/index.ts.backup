import * as http from 'http';
import { createProxyServer } from 'http-proxy';
import { WebSocketServer } from 'ws';
import * as net from 'net';
import * as fs from 'fs';
import * as path from 'path';
import * as tls from 'tls';
import * as forge from 'node-forge';

import { handleHttpsConnect, cleanupAllServers } from './proxy/https-intercept';
import { loadOrCreateRootCA, getCAFingerprint, CA_CERT_PATH } from './cert-manager';
import { TrustStore, checkTrust } from './utils/trust-store';

const PROXY_PORT = parseInt(process.env.PROXY_PORT || '9876');
const WS_PORT = parseInt(process.env.WS_PORT || '9877');
const DASH_PORT = parseInt(process.env.DASH_PORT || '3000');

interface CapturedRequest {
  id: string;
  timestamp: number;
  method: string;
  url: string;
  protocol: string;
  host: string;
  path: string;
  headers: Record<string, string | string[]>;
  body?: string;
  bodySize?: number;
}

interface CapturedResponse {
  statusCode: number;
  statusMessage: string;
  headers: Record<string, string | string[]>;
  body?: string;
  bodySize?: number;
  duration: number;
  timestamp: number;
}

interface CapturedExchange {
  id: string;
  request: CapturedRequest;
  response?: CapturedResponse;
  isHttps?: boolean;
}

const proxy = createProxyServer({});
const server = http.createServer();
const wss = new WebSocketServer({ port: WS_PORT });

const exchanges = new Map<string, CapturedExchange>();
let nextId = 1;

function normalizeHeaders(headers: http.IncomingHttpHeaders): Record<string, string | string[]> {
  const result: Record<string, string | string[]> = {};
  for (const [key, value] of Object.entries(headers)) {
    result[key] = value as string | string[];
  }
  return result;
}

function broadcastExchange(exchange: CapturedExchange) {
  const message = JSON.stringify({ type: 'exchange', data: exchange });
  for (const client of wss.clients) {
    if ((client as any).readyState === 1) {
      (client as any).send(message);
    }
  }
}

wss.on('connection', (ws: any) => {
  for (const exchange of exchanges.values()) {
    ws.send(JSON.stringify({ type: 'exchange', data: exchange }));
  }
  ws.send(JSON.stringify({ type: 'summary', data: { count: exchanges.size } }));
});

/**
 * Extract body from a readable stream and return as string.
 * Used for logging request/response bodies.
 */
async function extractBody(stream: NodeJS.ReadableStream, contentType?: string): Promise<{ body?: string; size: number }> {
  const chunks: Buffer[] = [];
  return new Promise((resolve) => {
    stream.on('data', (chunk: Buffer) => chunks.push(chunk));
    stream.on('end', () => {
      const totalSize = chunks.reduce((acc, c) => acc + c.length, 0);
      if (totalSize === 0) {
        resolve({ size: 0 });
        return;
      }
      const combined = Buffer.concat(chunks);
      const ct = contentType || '';
      if (ct.includes('application/json') || ct.includes('text/') || ct.includes('+json')) {
        let body = combined.toString('utf8');
        if (body.length > 50000) body = body.substring(0, 50000) + '... [truncated]';
        resolve({ body, size: totalSize });
      } else {
        resolve({ body: `[Data: ${totalSize} bytes]`, size: totalSize });
      }
    });
    stream.on('error', () => {
      resolve({ size: 0 });
    });
  });
}

/**
 * Create a CA-issued certificate and return it as PEM strings.
 */
function generateMitmCert(hostname: string): { cert: string; key: string } {
  return loadOrCreateRootCA(); // We'll generate host-specific certs as needed
}

/**
 * Handle CONNECT tunneling for HTTPS traffic.
 * This is where HTTPS MITM interception happens.
 */
server.on('connect', (req: http.IncomingMessage, socket: net.Socket, head: Buffer) => {
  const host = req.url;
  if (!host) {
    socket.write('HTTP/1.1 400 Bad Request\r\n\r\n');
    socket.end();
    return;
  }

  const [hostname, portStr] = host.split(':');
  const port = parseInt(portStr, 10) || 443;

  console.log(`\n[HTTPS] CONNECT ${hostname}:${port}`);

  // Create exchange record
  const exchangeId = (nextId++).toString();
  const exchange: CapturedExchange = {
    id: exchangeId,
    request: {
      id: exchangeId,
      timestamp: Date.now(),
      method: req.method || 'CONNECT',
      url: `https://${host}`,
      protocol: 'HTTPS',
      host: hostname,
      path: '/',
      headers: normalizeHeaders(req.headers),
    },
    isHttps: true,
  };
  exchanges.set(exchangeId, exchange);
  broadcastExchange(exchange);

  // Handle HTTPS interception
  handleHttpsConnect(
    req,
    socket,
    head,
    {
      onRequest: async (mitmReq, mitmSocket, mitmHead, hn, p) => {
        // Request intercepted - we could inspect decrypted data here
      },
      onResponse: async (mitmRes, mitmReq, mitmSocket, mitmHead) => {
        // Response intercepted
      },
    }
  );
});

/**
 * Handle regular HTTP requests.
 */
server.on('request', async (req, res) => {
  // Skip dashboard requests
  if (req.url === '/' || (req.url && req.url.startsWith('/index.html')) || (req.url && (req.url.endsWith('.js') || req.url.endsWith('.css') || req.url.endsWith('.html')))) {
    // Let dashboard handler deal with it
    return;
  }

  const exchangeId = (nextId++).toString();
  const timestamp = Date.now();

  const { body: reqBody, size: reqBodySize } = await extractBody(req, req.headers['content-type'] as string);

  const urlStr = req.url || '/';
  let targetUrl: URL;
  try {
    targetUrl = new URL(urlStr);
  } catch {
    try {
      const host = req.headers.host as string || '';
      targetUrl = new URL(`http://${host}${req.url}`);
    } catch {
      targetUrl = new URL(`http://dummy${req.url}`);
    }
  }

  const request: CapturedRequest = {
    id: exchangeId,
    timestamp,
    method: req.method || 'GET',
    url: urlStr,
    protocol: ((req.socket as any).encrypted ? 'HTTPS' : 'HTTP') as string,
    host: targetUrl.hostname,
    path: targetUrl.pathname + targetUrl.search,
    headers: normalizeHeaders(req.headers),
    body: reqBody,
    bodySize: reqBodySize,
  };

  const exchange: CapturedExchange = {
    id: exchangeId,
    request,
    isHttps: false,
  };
  exchanges.set(exchangeId, exchange);
  broadcastExchange(exchange);

  // Determine proxy target
  let target: string;
  if (urlStr.startsWith('http')) {
    target = urlStr;
  } else {
    const host = req.headers.host as string || '';
    target = `http://${host}${req.url}`;
  }

  (req as any)._exchangeId = exchangeId;
  (req as any)._startTime = timestamp;

  const proxyReq = proxy.web(req, res, { target, changeOrigin: true, ignorePath: false }, (err: any) => {
    if (!(res as any).headersSent) {
      (res as any).writeHead(502, { 'Content-Type': 'text/plain' });
      (res as any).end('Bad Gateway: ' + err.message);
    }
  });

  // Capture response body
  const originalWriteHead = (res as any).writeHead;
  (res as any).writeHead = function (statusCode: number, statusMessage?: any, headers?: any) {
    if (!this._headersWritten) {
      this._headersWritten = true;
      if (typeof statusMessage === 'object' && !statusMessage.toString) {
        headers = statusMessage;
        statusMessage = undefined;
      }
      return originalWriteHead.call(this, statusCode, statusMessage as any, headers);
    }
    return this;
  };
});

/**
 * Capture proxy responses.
 */
proxy.on('proxyRes', async (proxyRes: http.IncomingMessage, req: http.IncomingMessage) => {
  const exchangeId = (req as any)._exchangeId as string;
  const startTime = (req as any)._startTime as number;
  const endTime = Date.now();
  const duration = endTime - startTime;

  const { body: resBody, size: resBodySize } = await extractBody(proxyRes, proxyRes.headers['content-type'] as string);

  const response: CapturedResponse = {
    statusCode: proxyRes.statusCode || 0,
    statusMessage: proxyRes.statusMessage || '',
    headers: normalizeHeaders(proxyRes.headers),
    body: resBody,
    bodySize: resBodySize,
    duration,
    timestamp: endTime,
  };

  const exchange = exchanges.get(exchangeId);
  if (exchange) {
    exchange.response = response;
    exchanges.set(exchangeId, exchange);
    broadcastExchange(exchange);
  }
});

proxy.on('error', (err: any, req: any, res: any) => {
  if (res && !(res as any).headersSent) {
    (res as any).writeHead(502, { 'Content-Type': 'text/plain' });
    (res as any).end('Bad Gateway: ' + err.message);
  }
});

/**
 * Dashboard static file server.
 */
const mimeTypes: Record<string, string> = {
  '.html': 'text/html',
  '.js': 'application/javascript',
  '.css': 'text/css',
  '.json': 'application/json',
  '.png': 'image/png',
  '.jpg': 'image/jpeg',
  '.svg': 'image/svg+xml',
  '.ico': 'image/x-icon',
};

const dashboardDir = path.join(__dirname, 'dashboard');

const dashboardServer = http.createServer((req, res) => {
  try {
    let reqPath = req.url === '/' ? '/index.html' : req.url || '/index.html';
    // Security: prevent directory traversal
    if (reqPath.includes('..')) {
      res.writeHead(403);
      res.end('Forbidden');
      return;
    }
    const filePath = path.join(dashboardDir, reqPath);

    // Security: ensure filePath is within dashboardDir
    if (!filePath.startsWith(dashboardDir)) {
      res.writeHead(403);
      res.end('Forbidden');
      return;
    }

    // Handle API endpoints
    if (reqPath === '/api/exchanges') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify(Array.from(exchanges.values())));
      return;
    }

    if (!fs.existsSync(filePath)) {
      res.writeHead(404);
      res.end('Not Found');
      return;
    }

    const ext = path.extname(filePath).toLowerCase();
    const contentType = mimeTypes[ext] || 'application/octet-stream';
    res.writeHead(200, { 'Content-Type': contentType });
    fs.createReadStream(filePath).pipe(res);
  } catch (err) {
    res.writeHead(500);
    res.end('Server Error');
  }
});

// ===== Startup Sequence =====
console.log('\n=== AI Agent Proxy Starting ===\n');

// Initialize CA certificates (this will generate if not exists)
loadOrCreateRootCA();

// Auto-configure NODE_EXTRA_CA_CERTS for this process
const trustInfo = checkTrust();
if (!trustInfo.configured) {
  console.log('\n\u26a0 Note: NODE_EXTRA_CA_CERTS is not configured.');
  console.log(`   To enable HTTPS interception for Node.js apps:`);
  console.log(`   ${TrustStore.getSetupCommand()}\n`);
}

// Verify HTTPS interception capability
const caExists = fs.existsSync(CA_CERT_PATH);
if (caExists) {
  const fp = getCAFingerprint();
  console.log('\n\ud83d\udd10 HTTPS Interception: Ready');
  console.log(`   CA: ${CA_CERT_PATH}`);
  console.log(`   Fingerprint: ${fp}\n`);
}

// Start proxy server
server.listen(PROXY_PORT, () => {
  console.log(`\n🚀 Proxy Server: http://localhost:${PROXY_PORT}`);
  console.log(`   WebSocket:    ws://localhost:${WS_PORT}`);
});

// Start dashboard
dashboardServer.listen(DASH_PORT, () => {
  console.log(`\n📊 Dashboard:   http://localhost:${DASH_PORT}`);
});

console.log('\n--- Configuration ---');
console.log(`   HTTP_PROXY=http://localhost:${PROXY_PORT}`);
console.log(`   HTTPS_PROXY=http://localhost:${PROXY_PORT}`);
console.log('\n   For HTTPS interception, configure agents to trust the CA.');
console.log('   See dashboard for live request inspection.\n');
console.log('=== Ready ===\n');

// Cleanup on shutdown
process.on('SIGINT', () => {
  console.log('\n\nShutting down...');
  cleanupAllServers();
  process.exit(0);
});

process.on('SIGTERM', () => {
  cleanupAllServers();
  process.exit(0);
});
