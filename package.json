{
  "name": "ai-agent-proxy",
  "version": "0.3.0",
  "description": "LLM-aware HTTP proxy for inspecting AI agent API traffic with HTTPS interception",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "setup-trust": "ts-node scripts/setup-trust.ts",
    "build:sdk": "cd packages/sdk && npm run build",
    "test": "ts-node src/test/integration.test.ts",
    "demo": "ts-node src/test/demo.ts"
  },
  "dependencies": {
    "@ai-agent-proxy/sdk": "file:./packages/sdk",
    "@types/http-proxy-middleware": "^0.19.3",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^3.0.5",
    "node-forge": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
