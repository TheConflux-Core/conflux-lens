{
  "name": "@conflux/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for programmatic HTTP/HTTPS interception and AI agent traffic monitoring with Conflux Lens",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --out-dir dist --sourcemap",
    "dev": "tsup src/index.ts --format cjs --dts --out-dir dist --sourcemap --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "proxy",
    "http",
    "https",
    "intercept",
    "ai-agent",
    "conflux",
    "lens",
    "sdk"
  ],
  "author": "The Conflux, LLC",
  "license": "MIT",
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}